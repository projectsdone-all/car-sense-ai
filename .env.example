# Optional — set these in Vercel → Project → Settings → Environment Variables.

# Real AI damage detection for every visitor (free key: https://aistudio.google.com/apikey).
# Without it, users can paste their own key on the Profile screen, or the app runs in labelled demo mode.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: your own YOLOv8 service (POST {url}/api/detect-damage, multipart field "image").
VITE_AI_API_URL=
